{
  "name": "rea-ui-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "按网页、桌面和手机分类的产品风格研究与参考实现库",
  "engines": {"node": ">=22.13"},
  "scripts": {
    "dev": "node tools/serve.mjs",
    "dev:private": "node tools/serve.mjs --private",
    "build": "node tools/build.mjs",
    "readme:capture": "node tools/capture-readme.mjs",
    "verify": "node tools/verify.mjs",
    "test": "node --test tests/*.test.mjs skills/rea-design-transfer/scripts/*.test.mjs",
    "sources:status": "node tools/studies.mjs status",
    "sources:init": "node tools/init-sources.mjs",
    "study:add": "node tools/studies.mjs add",
    "study:lock": "node tools/studies.mjs lock"
  }
}
