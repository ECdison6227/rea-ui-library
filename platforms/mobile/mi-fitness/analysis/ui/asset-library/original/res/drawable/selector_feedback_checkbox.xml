<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/common_btn_normal_red_bg_color" />
            <corners android:radius="@dimen/dimen_margin_18dp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimen_margin_18dp" />
            <solid android:color="@color/trail_feedback_unchecked_bg" />
            <stroke android:width="0.39999998dp" android:color="@color/common_view_shadow_color" />
        </shape>
    </item>
</selector>
