<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/about_size_15_33" />
            <solid android:color="#ff5b5a" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/about_size_15_33" />
            <solid android:color="@color/about_primary_color_70" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/about_size_15_33" />
            <solid android:color="@color/about_primary_color" />
        </shape>
    </item>
</selector>
