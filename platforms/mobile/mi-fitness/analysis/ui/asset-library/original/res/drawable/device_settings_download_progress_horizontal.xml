<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5.0dp" />
            <size android:height="@dimen/dimen_margin_5dp" />
            <solid android:color="@color/device_settings_progressbar_color" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:tint="?colorControlActivated" android:shape="rectangle">
                <corners android:radius="5.0dp" />
                <size android:height="@dimen/dimen_margin_5dp" />
                <solid android:color="@color/colorPrimary" />
            </shape>
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="5.0dp" />
                <size android:height="@dimen/dimen_margin_5dp" />
                <solid android:color="@color/colorPrimary" />
            </shape>
        </scale>
    </item>
</layer-list>
