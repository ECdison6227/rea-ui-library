<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/common_btn_normal_bg_color" />
                    <corners android:radius="@dimen/checkupdate_btn_corner_round_radius" />
                    <size android:height="@dimen/miuix_appcompat_button_height" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/common_btn_pressed_bg_color" />
                    <corners android:radius="@dimen/checkupdate_btn_corner_round_radius" />
                    <size android:height="@dimen/miuix_appcompat_button_height" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/common_btn_disable_bg_color" />
            <corners android:radius="@dimen/checkupdate_btn_corner_round_radius" />
            <size android:height="@dimen/miuix_appcompat_button_height" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/checkupdate_btn_corner_round_radius" />
            <solid android:color="@color/common_btn_normal_bg_color" />
            <size android:height="@dimen/miuix_appcompat_button_height" />
        </shape>
    </item>
</selector>
