<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6.0dp" />
            <solid android:color="@color/common_btn_gray_solid_disable_bg_color" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/common_btn_gray_solid_pressed_bg_color" />
            <corners android:radius="6.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6.0dp" />
            <solid android:color="@color/common_btn_gray_solid_normal_bg_color" />
        </shape>
    </item>
</selector>
