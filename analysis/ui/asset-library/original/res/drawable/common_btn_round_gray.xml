<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/black_07" />
            <corners android:radius="@dimen/dimen_round_33.33dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimen_round_33.33dp" />
            <solid android:color="@color/sleep_quality_circle_marks_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimen_round_33.33dp" />
            <solid android:color="@color/black_3" />
        </shape>
    </item>
</selector>
