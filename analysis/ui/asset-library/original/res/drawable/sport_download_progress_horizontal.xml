<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="1.0dp" />
            <size android:height="2.0dp" />
            <solid android:color="#b7b6bb" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:tint="?colorControlActivated" android:shape="rectangle">
                <corners android:radius="1.0dp" />
                <size android:height="2.0dp" />
                <solid android:color="@color/black_50_transparent" />
            </shape>
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="1.0dp" />
                <size android:height="2.0dp" />
                <solid android:color="@color/common_main_dark_gray_color" />
            </shape>
        </scale>
    </item>
</layer-list>
