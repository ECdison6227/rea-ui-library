<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pressed_common_item_bg_color" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16.0dp" />
            <solid android:color="@color/card_bg_normal" />
        </shape>
    </item>
</selector>
