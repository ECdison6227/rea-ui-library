<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/common_btn_corner_round_radius" />
            <size android:height="@dimen/common_btn_height" />
            <solid android:color="#33ff612e" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:tint="?colorControlActivated" android:shape="rectangle">
                <corners android:radius="@dimen/common_btn_corner_round_radius" />
                <size android:height="@dimen/common_btn_height" />
                <solid android:color="#33ff612e" />
            </shape>
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale>
            <clip android:gravity="left" android:clipOrientation="horizontal">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/common_btn_corner_round_radius" />
                    <size android:height="@dimen/common_btn_height" />
                    <solid android:color="@color/common_btn_normal_red_bg_color" />
                </shape>
            </clip>
        </scale>
    </item>
</layer-list>
